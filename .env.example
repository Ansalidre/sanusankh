# Serverseitige Variablen der Netlify-Funktionen (netlify/functions/*.mjs). Nie in die App eintragen.
# Lokal: Datei nach .env kopieren. Netlify: Site configuration → Environment variables.

# KI-Assistent
ANTHROPIC_API_KEY=
# Optional, Standard: claude-haiku-5-5 (günstig; andere Modelle z. B. claude-sonnet-5-5 kosten deutlich mehr)
ANTHROPIC_MODEL=

# Admin-Ansicht /admin – gemeinsames Passwort, mindestens 12 Zeichen. Ohne Wert ist /admin gesperrt.
ADMIN_PASSWORD=
# Geheimnis für pseudonyme Zähler (Missbrauchsschutz). Lange Zufallszeichenkette.
HASH_SECRET=

# E-Mail-Versand über Brevo. Ohne beide Werte: Testbetrieb (nichts wird versendet,
# das Protokoll enthält nur Code, Bestatter, Leistung und Zeitstempel).
BREVO_API_KEY=
# Bei Brevo bestätigte Absenderadresse, z. B. anfragen@sanusankh.de
MAIL_FROM=
MAIL_FROM_NAME=SanusAnkh

# Optional: Demo-Bestatter anlegen, wenn noch keine Partner existieren (lokal automatisch).
SEED_DEMO_PARTNERS=
