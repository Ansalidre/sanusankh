# Adresse der KI-Serverfunktion (netlify/functions/assistant.mjs im Hauptprojekt).
# Ohne Wert läuft die App ohne KI: Assistent zeigt einen Hinweis, Inhalte erscheinen auf Deutsch.
# Lokal testen: im Hauptprojekt `npm run dev` starten und die LAN-IP des Rechners eintragen,
# z. B. http://192.168.178.20:5173/api/assistant
EXPO_PUBLIC_API_URL=https://DEINE-SEITE.netlify.app/api/assistant
