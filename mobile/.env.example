# Basisadresse der Serverfunktionen (netlify/functions/*.mjs im Hauptprojekt):
# KI-Assistent (/assistant), Kooperations-Bestatter (/partners) und Anfragen (/requests).
# Ohne Wert läuft die App ohne KI und ohne Bestatter-Anfragen.
# Lokal testen: im Hauptprojekt `npm run dev -- --host` starten und die LAN-IP des Rechners eintragen,
# z. B. http://192.168.178.20:5173/api
EXPO_PUBLIC_API_URL=https://DEINE-SEITE.netlify.app/api
