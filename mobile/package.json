    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run lint && npm run check:i18n && npm run check:content",
    "build": "npm run check && eas build --platform all --profile production",
    "build:android": "npm run check && eas build --platform android --profile production",
    "build:ios": "npm run check && eas build --platform ios --profile production",
    "submit": "eas submit --platform all --profile production --latest",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "doctor": "npx expo-doctor"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
