    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.62.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
